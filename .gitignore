node_modules/
.env
npm-debug.log*
*.log
__pycache__/

# Database files
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
*.db
*.db-shm
*.db-wal

# Data directory (contains all database files and memory stores) - only the top-level one
/data/

# JSON backup/cache files
*.json

# Lumi-Town game data, test fixtures and front-end assets are real source files, not caches
!src/lumi/data/**/*.json
!tests/lumi/fixtures/*.json
!public/lumi/**/*.json
