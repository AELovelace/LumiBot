ls -al# SGCServer configuration. Copy to SGCServer/.env and adjust values.
# All values shown are defaults if unset.

# --- HTTP listener ----------------------------------------------------------
SGC_API_HOST=127.0.0.1
SGC_API_PORT=7788

# --- Internal listener (privileged routes for LumiBot) ----------------------
# Bind to 127.0.0.1 only — never expose to the internet.
SGC_INTERNAL_HOST=127.0.0.1
SGC_INTERNAL_PORT=7789

# Static bearer token presented by LumiBot in the Authorization header.
# Required for any /internal/* request. Generate with:
#   node -e "console.log('sgc_internal_' + require('crypto').randomBytes(32).toString('hex'))"
SGC_INTERNAL_TOKEN=

# --- OAuth listener ---------------------------------------------------------
# OAuth shares the public API listener (SGC_API_PORT) under /oauth/*.
# Set the issuer URL clients should use for redirects/audit.
SGC_OAUTH_ISSUER=https://sadgirlsclub.wtf/oauth

# --- Database ---------------------------------------------------------------
# Absolute path to the SadGirlCoin SQLite DB. MUST match LumiBot's
# config.economyDbFile. WAL mode is enabled automatically.
# Leave UNSET to default to <repo>/data/sadgirlcoin.sqlite3 (cross-platform).
# Examples:
#   Linux  : SGC_DB_FILE=/opt/sadgirlplayer/data/sadgirlcoin.sqlite3
#   Windows: SGC_DB_FILE=C:/Scripts/LumiBot/data/sadgirlcoin.sqlite3
#SGC_DB_FILE=

# --- Link codes -------------------------------------------------------------
SGC_API_LINK_CODE_TTL_MS=600000

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=debug
