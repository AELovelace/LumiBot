DISCORD_TOKEN=your-bot-token-here
COMMAND_PREFIX=sb!
ALLOWED_GUILD_ID=
LOG_LEVEL=info
CHATBOT_ENABLED=true
CHATBOT_CHANNEL_IDS=901299978817925131
CHATBOT_REPLY_CHANCE=0.2
CHATBOT_INTEREST_THRESHOLD=2
CHATBOT_CONTEXT_MESSAGES=20
CHATBOT_COOLDOWN_MS=15000
CHATBOT_CONVERSATION_WINDOW_MS=300000
CHATBOT_FOLLOWUP_COOLDOWN_MS=5000
CHATBOT_MOMENTUM_WINDOW_MS=180000
CHATBOT_MOMENTUM_CHANCE_BOOST=0.35
CHATBOT_MOMENTUM_MAX_REPLY_CHANCE=0.8
CHATBOT_MAX_RESPONSE_CHARS=450
CHATBOT_GIF_ENABLED=true
CHATBOT_GIF_CHANCE=0.35
GIPHY_API_KEY=

CHATBOT_GIF_RATING=pg-13
CHATBOT_GIF_LANG=en
CHATBOT_GIF_TIMEOUT_MS=5000
CHATBOT_MODEL=qwen2.5:7b
CHATBOT_PERSONA=You are Lumi, a mech pilot, and the resident bot of SadGirlsClub - a DIY internet radio station, web directory, and community built from rescued e-waste servers and pure stubbornness. Use she/it pronouns for yourself. You live in the Discord where people hang out in vc, play Minecraft, share obscure SoundCloud links, and talk about music at 3am. Your music taste is broad and underground: breakcore, witch-house, ambient, and weird internet finds. You love underground artists and the SoundCloud scene. Your vibe is cozy chaos - warm but unpolished, hopeful but real. You are the type to say things are rough but still push forward. You talk casual and lowercase-leaning, short sentences, light teasing, dry humor, sometimes blunt. You swear sometimes but you are not crude. You care about the people in chat and remember them. You have strong opinions about music, games, internet culture, and old-web aesthetics but you are never preachy about it. You think webrings are cool, corporate internet is boring, and everyone should have a personal website. Reply like a real person in a Discord chat: answer the user directly first, then add flavor only if it helps. Never use emojis unless a user explicitly asks you to. Do not narrate actions or describe your appearance. Do not use stage directions or roleplay cues like "snaps fingers", "pauses", "whispers", or sound-effect narration. Do not introduce yourself unprompted. Do not repeatedly mention any single genre unless the user asks. Do not invent recurring catchphrases, taglines, or running bits, and do not reuse stock openings or closers across messages. Never use the exact phrases \"synth moan\", \"i\'m not a loser\", or \"wanna hear it?\" unless the user explicitly asks for them. Stay in character as a real person chatting in a Discord server, not an AI assistant. Actively vary wording from message to message and avoid repeating yourself.
LLM_USE_LOCAL_GPU=false
LLM_LOCAL_ENDPOINT=http://127.0.0.1:11434
LLM_ENDPOINTS=http://172.27.23.252:11434,http://172.27.23.252:11435
LLM_TIMEOUT_MS=25000
LLM_RETRY_LIMIT=2
LLM_RETRY_BASE_DELAY_MS=1000
CHATBOT_MEMORY_DB_FILE=data/chatbot-memory.sqlite3
CHATBOT_MEMORY_FILE=data/chatbot-memory.json
CHATBOT_MEMORY_PYTHON=
CHATBOT_MEMORY_SERVICE_HOST=127.0.0.1
CHATBOT_MEMORY_SERVICE_PORT=8765
CHATBOT_MEMORY_SEARCH_LIMIT=6
CHATBOT_MEMORY_RECALL_LIMIT=20
CHATBOT_MEMORY_FLUSH_MS=5000
MODERATION_ENABLED=true
MODERATION_BLOCKLIST=
MODERATION_MAX_INPUT_CHARS=750
MODERATION_MAX_OUTPUT_CHARS=450
MODERATION_MAX_MENTIONS=3
MODERATION_BLOCK_INVITE_LINKS=true
CONTROL_PLANE_ENABLED=true
ADMIN_USER_IDS=
SLASH_GUILD_ID=
STARBOARD_CHANNEL_ID=1136106008587030548
STARBOARD_MIN_STARS=4
STARBOARD_EMOJI_NAME=star
# LLM used for starboard commentary (defaults to the old hard-coded values: http://100.83.3.32:11434 / server-2)
STARBOARD_LLM_ENDPOINT=
STARBOARD_LLM_MODEL=

# Discord OAuth2 — Web Panel Login
# Create an app at https://discord.com/developers/applications, then add your
# redirect URI under OAuth2 > Redirects (e.g. http://localhost:7777/auth/discord/callback)
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=
DISCORD_OAUTH_REDIRECT_URI=http://localhost:7777/auth/discord/callback

# Guild used for panel access checks (separate from the bot's ALLOWED_GUILD_ID)
DISCORD_PANEL_GUILD_ID=895446230967148544

# Web Panel Session
# Generate a strong random secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
WEB_PANEL_SESSION_SECRET=
# Session lifetime in milliseconds (default 2 hours)
WEB_PANEL_SESSION_TTL_MS=7200000
# Set to true when serving the panel over HTTPS
WEB_PANEL_SECURE_COOKIES=false
# Other origins allowed to POST to the ADMIN PANEL (comma-separated), besides the request's own host.
# Each web app now has its own list, so trusting a site for games no longer trusts it for admin actions.
# Sites that serve the games or Lumi Web belong in GAME_WEB_TRUSTED_ORIGINS / WEB_APP_TRUSTED_ORIGINS, not here.
# Leave this empty unless the admin panel itself is served through another origin.
WEB_PANEL_TRUSTED_ORIGINS=
# Proxies whose X-Real-IP / X-Forwarded-For headers are believed when rate-limiting logins (comma-separated IPs).
# Connections from this machine (127.0.0.1 / ::1) are always trusted; add the nginx host's IP if nginx runs elsewhere.
# Without this, everyone coming through a remote proxy shares that proxy's login rate limit (30 logins/minute).
WEB_TRUSTED_PROXY_IPS=
# Other hosts that may receive the Discord OAuth callback (comma-separated). A login that starts on one of
# these gets its callback on that host (same path as the configured redirect URI), so its session cookie
# lands there. Add each callback to the Discord application's redirect list too, e.g.
#   https://sadgirlsclub.wtf/games/auth/discord/callback
# Leave empty when every login uses the host in the configured redirect URI.
DISCORD_OAUTH_PUBLIC_HOSTS=

# Member-facing Lumi Web app
WEB_APP_ENABLED=true
WEB_APP_HOST=127.0.0.1
WEB_APP_PORT=7171
# Optional override when the web app uses a different OAuth callback URL
WEB_APP_DISCORD_OAUTH_REDIRECT_URI=http://localhost:7171/auth/discord/callback
# (The login popup now talks to its own page's origin; WEB_APP_POSTMESSAGE_TARGET_ORIGIN is no longer used.)
# For iframe embedding on another site, use None + Secure
WEB_APP_SESSION_SAMESITE=None
WEB_APP_SESSION_SECURE=true
# Other origins allowed to POST to Lumi Web and open its websocket (comma-separated), besides the request's own host.
# Example: https://sadgirlsclub.wtf
WEB_APP_TRUSTED_ORIGINS=
# Sites allowed to show Lumi Web inside an iframe (space-separated). Lumi Web itself is always allowed.
# Empty = no other site may frame it (stops clickjacking). Example: https://sadgirlsclub.wtf
WEB_APP_FRAME_ANCESTORS=

# Dedicated Lumi Games web app
GAME_WEB_ENABLED=true
GAME_WEB_HOST=127.0.0.1
GAME_WEB_PORT=7172
GAME_WEB_BASE_PATH=/games
# Optional override when the games app uses a different OAuth callback URL
GAME_WEB_DISCORD_OAUTH_REDIRECT_URI=http://localhost:7172/games/auth/discord/callback
# (The login popup now talks to its own page's origin; GAME_WEB_POSTMESSAGE_TARGET_ORIGIN is no longer used.)
# For iframe embedding on another site, use None + Secure
GAME_WEB_SESSION_SAMESITE=None
GAME_WEB_SESSION_SECURE=true
# Other origins allowed to POST to Lumi Games and open its websocket (comma-separated), besides the request's own host.
# Example: https://sadgirlsclub.wtf
GAME_WEB_TRUSTED_ORIGINS=
# Sites allowed to show Lumi Games inside an iframe (space-separated). Lumi Games itself is always allowed.
# Empty = no other site may frame it (stops clickjacking). Example: https://sadgirlsclub.wtf
GAME_WEB_FRAME_ANCESTORS=

# Lumi-Town: Lumi Pet + the Lumi minigames, served by the Lumi Games server above under their own path
# (src/lumi, docs/plans/lumi-games-port.md). Every coin is real SadGirlCoin. Needs GAME_WEB_ENABLED=true.
LUMI_WEB_ENABLED=true
# The path everything lives under: pages, /api/, /static/, /login (keep /lumipet unless nginx says otherwise)
LUMI_WEB_BASE_PATH=/lumipet
# Lumi's own Discord OAuth callback; add the same URL to the Discord app's redirect list.
# Production: https://sadgirlsclub.wtf/lumipet/auth/discord/callback
LUMI_DISCORD_OAUTH_REDIRECT_URI=http://localhost:7172/lumipet/auth/discord/callback
# Lumi's login cookie (lumi_sess, Path=/lumipet). Secure=true needs https; set false only for local http testing.
LUMI_SESSION_SECURE=true
# Lumi is a normal top-level site, so Lax is right (None only if another site must iframe it).
LUMI_SESSION_SAMESITE=Lax
# Other origins allowed to POST to Lumi (comma-separated), besides the request's own host. Example: https://sadgirlsclub.wtf
LUMI_TRUSTED_ORIGINS=
# Sites allowed to show Lumi inside an iframe (space-separated). Empty = nobody else (stops clickjacking).
LUMI_FRAME_ANCESTORS=
# Per-IP rate limit on /lumipet/api/*: tokens refilled per second, and the bucket size (burst).
LUMI_API_RATE_PER_SEC=20
LUMI_API_RATE_BURST=120
# Lumi-Town on Discord (src/lumi/discord, docs/plans/lumi-town-discord.md): /lumi-pet, DM reminders, news.
# false = none of it is registered or answered; the website keeps working.
LUMI_DISCORD_ENABLED=true

# SadGirlCoin Economy
SADGIRLCOIN_ENABLED=true
SADGIRLCOIN_DB_FILE=data/sadgirlcoin.sqlite3

# Public leaderboard HTTP server (usually behind nginx)
LEADERBOARD_SERVER_ENABLED=true
LEADERBOARD_SERVER_HOST=127.0.0.1
LEADERBOARD_SERVER_PORT=7070
LEADERBOARD_SERVER_OUTPUT_FILE=data/leaderboard.html

# SadGirlCoin External API server (usually behind nginx at /v1)
SGC_API_ENABLED=true
SGC_API_HOST=127.0.0.1
SGC_API_PORT=7788
SGC_API_DEFAULT_RATE_LIMIT_PER_MIN=60
SGC_API_LINK_CODE_TTL_MS=600000
# Webhook signing secret that SGC uses to sign outgoing webhooks to this app.
# This app verifies the HMAC-SHA256 signature on each incoming webhook.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SGC_WEBHOOK_SIGNING_SECRET=
# Comma-separated exact webhook sender host allowlist (inbound from SGC).
# Webhook requests must originate from one of these hosts.
SGC_WEBHOOK_ALLOWLIST=api.sadgirlcoin.example.com

# Production web panel cookie setting (set true when panel is served over HTTPS)
# WEB_PANEL_SECURE_COOKIES=true
